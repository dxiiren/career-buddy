{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "bash -c 'ROOT=$(git rev-parse --show-toplevel) && cd \"$ROOT\" && uv run --no-project python .claude/hooks/statusline.py'",
    "padding": 0,
    "refreshInterval": 30
  },
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(git stash *)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git mv:*)",
      "Bash(git ls-files:*)",
      "Bash(git config *)",
      "Bash(git check-ignore:*)",
      "Bash(gh:*)",
      "Bash(just:*)",
      "Bash(uv run:*)",
      "Bash(npm run:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(curl:*)",
      "Bash(grep:*)",
      "Bash(findstr:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(rm -rf /*)",
      "mcp__github__delete_file",
      "mcp__github__merge_pull_request"
    ]
  },
  "enabledMcpjsonServers": ["context7", "playwright"]
}
